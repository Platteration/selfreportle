# Selfreportle, the website: Apache 2.4 settings. Netlify and Cloudflare Pages read _headers
# instead; nginx: deploy/nginx.conf. The headers are the same in all three and in the pages'
# <meta>, and test/website.test.js holds them equal. Publish the folder
# `node scripts/build-site.js <folder> --host=apache --base=/<path>/` writes, never a checkout;
# the build writes the base path into the two ErrorDocument lines below.
#
# The site's API (sign in with Google and "Support this app", server/start.mjs) cannot be proxied
# from here: mod_proxy is server configuration. In the virtual host, with mod_proxy and
# mod_proxy_http: ProxyPass "/api/" "http://127.0.0.1:8788/api/" (the path with --base in front
# for a sub-folder), and the Strict-Transport-Security header there, since a proxied answer never
# reads this file. Without that, the folder's api/config answers that nothing is on, and the page
# draws no sign-in and no shop.
#
# It needs mod_rewrite, mod_headers and mod_mime (`a2enmod rewrite headers`: Debian and Ubuntu
# leave the first two off), and `AllowOverride All` on the folder, or at least
# `FileInfo Indexes Options` (Debian and Ubuntu ship `AllowOverride None`, which ignores this file
# without a word). Nothing here is wrapped in <IfModule>: without a module every request answers
# 500 and the error log names the directive ("Invalid command 'RewriteEngine'"), where the wrappers
# served every file in the folder, .git/ included, with none of these headers, and logged nothing.
# test/e2e/hosts.js runs this file in a real Apache, with the modules and without them.

Options -Indexes
ServerSignature Off
AddDefaultCharset utf-8
DirectoryIndex index.html
# A missing page, a folder and a refused file all show the site's own not-found page.
ErrorDocument 404 %BASE%404.html
ErrorDocument 403 %BASE%404.html

AddType text/javascript .js
AddType image/png .png
# the licence has no extension; serve it as text rather than a download
<Files "LICENSE">
  ForceType text/plain
</Files>

RewriteEngine On
# everything over https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# The site's own files and nothing else: this file, the extension's other scripts, the
# repository's notes and tests, dotfiles (.git above all) and folders all answer 404, so a
# server pointed at the wrong folder still publishes only the site.
RewriteRule !^(index\.html|404\.html|app\.js|account\.js|guard\.js|site\.css|robots\.txt|LICENSE|icons/icon32\.png|\.well-known/security\.txt|api/config|lib/(lexicons|signals|verdicts|text-analyzer|site-analyzer|image-hints|legitimacy|attribution|cbor|x509|c2pa-verify|image-metadata)\.js)?$ - [R=404,L]

Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types selfreportle-saved-page; frame-ancestors 'none'; upgrade-insecure-requests"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), window-management=(), xr-spatial-tracking=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
# On every response, as _headers and nginx send it. A browser ignores it over plain http
# (RFC 6797, 8.1), and an `env=HTTPS` condition, set only by mod_ssl, left it off everything a
# TLS-terminating proxy forwards, which the redirect above accepts as https.
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
# no file name carries a version: revalidate every load (an unchanged file is a 304)
Header always set Cache-Control "no-cache"
