{
  "manifest_version": 3,
  "name": "Selfreportle – AI Content Disclosure Detector",
  "short_name": "Selfreportle",
  "version": "0.1.0",
  "description": "Shows whether a page's code, text and images carry AI-generation markers or disclosures (C2PA Content Credentials, IPTC/XMP metadata, generator fingerprints, hidden Unicode watermarks) in the context of EU AI Act Article 50.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Selfreportle – AI content signals for this page",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": [
        "lib/signals.js",
        "lib/settings.js",
        "lib/verdicts.js",
        "lib/text-analyzer.js",
        "lib/site-analyzer.js",
        "lib/image-hints.js",
        "content/overlay.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
